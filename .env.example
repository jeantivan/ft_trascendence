# Copy this file to .env and replace the values: cp .env.example .env
# Never commit .env (it is in .gitignore).

# PostgreSQL (used by the db service to create the user and database on first start)
# TODO before evaluation: replace this shared dev password with a random one
# generated per machine (planned: Makefile). See issue #14.
POSTGRES_USER=transcendence
POSTGRES_PASSWORD=dev_password_local_only
POSTGRES_DB=transcendence
