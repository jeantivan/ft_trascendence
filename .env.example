# make and make dev create .env from this file and add any missing variables.
# Never commit .env (it is in .gitignore).

# PostgreSQL (used by the db service to create the user and database on first start)
# POSTGRES_PASSWORD stays empty here: make and make dev generate it (scripts/env-sync.sh)
# To change it later: make fclean, then make (deletes ALL the local database data)
POSTGRES_USER=transcendence
POSTGRES_PASSWORD=
POSTGRES_DB=transcendence
# Tests: make test builds DATABASE_URL_TEST itself (database ${POSTGRES_DB}_test,
# user and password from above), so it is not set here. See docs/testing.md.

# Internal legal drafts (/privacy and /terms). Server-only: do not add NEXT_PUBLIC_.
# Only the exact value "true" shows the drafts; anything else returns 404.
# To review them locally, set LEGAL_DRAFTS_ENABLED=true in your .env and recreate
# the app container: docker compose up -d app
LEGAL_DRAFTS_ENABLED=false

# Host port where the app answers: https://localhost:8443 (nginx, the only entry point)
HTTPS_PORT=8443

# Auth.js / NextAuth (session encryption key and trusted host behind proxy)
# AUTH_SECRET stays empty here: make and make dev generate it (scripts/env-sync.sh)
AUTH_SECRET=
AUTH_TRUST_HOST=true

# Test mail inbox (Mailpit): mail sent here never leaves Docker.
# Read it at /mailpit/ with the user "demo" and MAILPIT_PASSWORD.
# MAILPIT_PASSWORD stays empty here: make and make dev generate it (scripts/env-sync.sh)
SMTP_HOST=mailpit
SMTP_PORT=1025
MAIL_FROM=no-reply@stridesync.local
MAILPIT_PASSWORD=

# Seed demo users password (used by prisma/seed.ts during development)
SEED_USER_PASSWORD=dev_password_123
